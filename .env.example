# Copia este archivo como .env y completa tus datos
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL 17 (la misma contraseña que pusiste al instalar PostgreSQL / pgAdmin 4)
DB_ENGINE=postgres
DB_NAME=optiruta
DB_USER=postgres
DB_PASSWORD=tu_contraseña_de_postgres
DB_HOST=localhost
DB_PORT=5432

# Centro de distribución (almacén) de la empresa
DEPOSITO_LAT=-6.778810
DEPOSITO_LNG=-79.868766

# Duración del token de acceso (minutos)
JWT_ACCESS_MIN=60

# Correo: por defecto se muestra en la consola. Para Gmail real usa:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_USER=tucorreo@gmail.com
# EMAIL_HOST_PASSWORD=contraseña_de_aplicación

# Celery (tareas en segundo plano)
#   True  = las tareas se ejecutan al instante (no necesitas abrir nada más)
#   False = se envían a la cola; abre otra terminal con:  celery -A config worker --pool=solo -l info
CELERY_TASK_ALWAYS_EAGER=True
